@page
@model RROMS.Pages.Admin.AnnouncementsModel
@{
    ViewData["Title"] = "Announcements";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Announcements</h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAnnModal"><i class="bi bi-plus-lg"></i> New announcement</button>
</div>

<div class="row g-3">
    @foreach (var a in Model.Announcements)
    {
        <div class="col-md-6">
            <div class="rroms-card p-3">
                <div class="d-flex justify-content-between">
                    <strong>@a.Title</strong>
                    <span class="status-badge @(a.IsActive ? "status-confirmed" : "status-cancelled")">@(a.IsActive ? "Active" : "Hidden")</span>
                </div>
                <p class="small mt-2 mb-2">@a.Content</p>
                <div class="small text-muted-warm mb-2">Posted @a.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") @(a.ExpiresAt.HasValue ? $"- expires {a.ExpiresAt:dd MMM yyyy}" : "")</div>
                <div class="d-flex gap-2">
                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@a.Id">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(a.IsActive ? "Hide" : "Show")</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@a.Id" onsubmit="return confirm('Delete this announcement?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Announcement Modal -->
<div class="modal fade" id="addAnnModal"><div class="modal-dialog"><div class="modal-content">
    <form method="post" asp-page-handler="Add">
        <div class="modal-header"><h5 class="modal-title">New announcement</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="mb-2"><label class="form-label">Title</label><input name="title" class="form-control" required /></div>
            <div class="mb-2"><label class="form-label">Content</label><textarea name="content" class="form-control" rows="3" required></textarea></div>
            <div class="mb-2"><label class="form-label">Expires (optional)</label><input type="date" name="expiresAt" class="form-control" /></div>
            <div class="form-check"><input type="checkbox" name="notifyCustomers" value="true" class="form-check-input" id="notifyAnnCustomers" /><label class="form-check-label" for="notifyAnnCustomers">Notify all customers</label></div>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-primary">Publish</button></div>
    </form>
</div></div></div>
