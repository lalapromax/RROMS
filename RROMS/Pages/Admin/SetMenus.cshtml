@page
@model RROMS.Pages.Admin.SetMenusModel
@{
    ViewData["Title"] = "Set menus";
}

<div class="wrap main stage">
    <div class="page-head">
        <div>
            <h1>Set menus</h1>
            <p>The menus guests can choose for the whole table. Staff and administrators can both create them.</p>
        </div>
        <div class="row-acts">
            <a class="btn btn-line" asp-page="/Admin/MenuManagement">Back to the menu</a>
            <a class="btn btn-wine" asp-page="/Admin/SetMenus/Edit">New set menu</a>
        </div>
    </div>
    <partial name="_SetMenuCards" model="Model" />
</div>
