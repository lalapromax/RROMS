@page "{id:int}"
@model RROMS.Pages.Orders.DetailsModel
@{
    ViewData["Title"] = "Order #" + Model.Order?.Id;
}

@if (Model.Order == null)
{
    <p>Order not found.</p>
}
else
{
    var o = Model.Order;
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
            <p class="rroms-section-eyebrow mb-1">Receipt</p>
            <h1 class="h3 mb-0">Order #@o.Id</h1>
        </div>
        <span class="status-badge status-@o.Status.ToString().ToLower() fs-6">@o.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="rroms-card p-4">
                <table class="table rroms-table mb-0">
                    <thead><tr><th>Item</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var item in o.OrderItems)
                        {
                            <tr>
                                <td>
                                    @item.ItemNameSnapshot
                                    @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                    {
                                        <div class="small text-muted-warm">@item.SpecialInstructions</div>
                                    }
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="3" class="text-end">Subtotal</td><td>@o.SubTotal.ToString("C")</td></tr>
                        <tr><td colspan="3" class="text-end">Tax</td><td>@o.TaxAmount.ToString("C")</td></tr>
                        <tr class="fw-semibold"><td colspan="3" class="text-end">Total</td><td>@o.TotalAmount.ToString("C")</td></tr>
                    </tfoot>
                </table>
            </div>

            @if (Model.CanCancel)
            {
                <form method="post" asp-page-handler="Cancel" asp-route-id="@o.Id" class="mt-3" onsubmit="return confirm('Cancel this order?');">
                    <button type="submit" class="btn btn-outline-danger">Cancel order</button>
                </form>
            }

            @if (o.Status == OrderStatus.Completed)
            {
                <a asp-page="/Feedback/Create" asp-route-orderId="@o.Id" class="btn btn-herb mt-3">Leave feedback for this order</a>
            }
        </div>

        <div class="col-lg-4">
            <div class="rroms-card p-4 mb-3">
                <h2 class="h6 mb-3">Order info</h2>
                <p class="small mb-1"><strong>Placed:</strong> @o.OrderDate.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
                <p class="small mb-1"><strong>Type:</strong> @o.OrderType</p>
                @if (o.Table != null)
                {
                    <p class="small mb-1"><strong>Table:</strong> @o.Table.TableNumber</p>
                }
                @if (!string.IsNullOrWhiteSpace(o.Notes))
                {
                    <p class="small mb-0"><strong>Notes:</strong> @o.Notes</p>
                }
            </div>

            <div class="rroms-card p-4">
                <h2 class="h6 mb-3">Payment</h2>
                @if (o.Payment != null)
                {
                    <p class="small mb-1"><strong>Method:</strong> @o.Payment.Method</p>
                    <p class="small mb-1"><strong>Status:</strong> <span class="status-badge status-@o.Payment.Status.ToString().ToLower()">@o.Payment.Status</span></p>
                    <p class="small mb-1"><strong>Amount:</strong> @o.Payment.Amount.ToString("C")</p>
                    @if (!string.IsNullOrWhiteSpace(o.Payment.TransactionReference))
                    {
                        <p class="small mb-0"><strong>Reference:</strong> @o.Payment.TransactionReference</p>
                    }
                }
                else
                {
                    <p class="small text-muted-warm mb-0">No payment record.</p>
                }
            </div>
        </div>
    </div>
}
