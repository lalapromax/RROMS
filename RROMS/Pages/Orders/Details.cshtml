@page
@model RROMS.Pages.Orders.DetailsModel
@using RROMS.Models
@{
    var o = Model.Order;
    ViewData["Title"] = "Order #" + o.Id;

    var audience = ViewData["Audience"] as string ?? "guest";
    var app = audience != "guest";
    var placed = o.OrderDate.ToLocalTime();
    var pill = OrderView.Pill(o);
    var takeaway = o.OrderType == OrderType.Takeaway;

    // Where the "back" link goes depends on whose shell this is: a guest's orders, the staff order board, or the admin overview.
    var back = audience switch { "staff" => "Orders", "admin" => "Monitoring", _ => "My orders" };

    string Lead()
    {
        var day = placed.ToString("dddd d MMMM yyyy");
        if (audience == "guest")
            return takeaway || Model.PartySize == null
                ? day + ", to collect."
                : day + ", for your table of " + OrderView.Words(Model.PartySize.Value) + ".";
        var who = string.IsNullOrWhiteSpace(o.Customer?.FullName) ? "Guest" : o.Customer!.FullName;
        var where = takeaway ? "to collect" : o.Table != null ? "Table " + o.Table.TableNumber : "table to be set";
        return $"{who}, {day}, {where}.";
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/OrderDetails.css" asp-append-version="true" />
}

@if (app)
{
    <div class="wrap main stage">
        <div class="page-head">
            <div>
                <p class="crumb no-print">
                    @if (audience == "staff") { <a asp-page="/Staff/Orders">@back</a> }
                    else { <a asp-page="/Admin/Monitoring">@back</a> }
                    / #@o.Id
                </p>
                <h1>Order #@o.Id</h1>
                <p>@Lead()</p>
            </div>
            <div class="row-acts no-print">
                <span class="st @pill.Css">@pill.Text</span>
                <button type="button" class="btn btn-line btn-sm" data-print>@Ui.Icon("dl", 16, 1.6) Receipt</button>
            </div>
        </div>
        <partial name="_OrderBody" model="Model" />
    </div>
}
else
{
    <section class="wrap page-top">
        <div>
            <p class="crumb no-print"><a asp-page="/Orders/Index">@back</a> / #@o.Id</p>
            <h1>Order #@o.Id</h1>
            <p class="lead-it">@Lead()</p>
        </div>
        <div class="head-acts no-print">
            <span class="st @pill.Css">@pill.Text</span>
            <button type="button" class="btn btn-line btn-sm" data-print>@Ui.Icon("dl", 16, 1.6) Receipt</button>
        </div>
    </section>
    <div class="wrap main">
        <partial name="_OrderBody" model="Model" />
    </div>
}
