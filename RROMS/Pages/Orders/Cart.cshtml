@page
@model RROMS.Pages.Orders.CartModel
@using RROMS.ViewModels
@{
    ViewData["Title"] = "Your cart";
    var q = Model.Quote;
    var empty = q.Lines.Count == 0;
    var errs = ViewData.ModelState.TryGetValue(string.Empty, out var e) ? e.Errors.Select(x => x.ErrorMessage).ToList() : new List<string>();
    var method = Model.Checkout.PaymentMethod;
    var online = Model.StripeEnabled;
    var blocked = empty || q.HasProblem;

    string Pretty(CartItemVM c) => c.Kind switch
    {
        CartKind.WineGlass => "A glass of " + c.Name,
        CartKind.WineBottle => "A bottle of " + c.Name,
        _ => c.Name
    };
    string Under(CartItemVM c) => c.Kind switch
    {
        CartKind.SetMenu => string.Join(" · ", c.Picks.Select(p => p.Name)),
        CartKind.WineGlass => "Cellar · by the glass",
        CartKind.WineBottle => "Cellar · bottle",
        _ => c.CategoryName ?? ""
    };
    string Booking(Reservation r) =>
        $"{r.ReservationDateTime:dddd d MMMM}, {r.ReservationDateTime:HH:mm} · {(r.Table != null && r.Status != ReservationStatus.Pending ? "Table " + r.Table.TableNumber : "table to be set")} · {r.PartySize} {(r.PartySize == 1 ? "guest" : "guests")}";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/Cart.css" asp-append-version="true" />
}

<section class="wrap page-top">
    <div>
        <p class="crumb"><a asp-page="/Menu/Index">Menu</a> / Cart</p>
        <h1>Your cart</h1>
        <p class="lead-it">Check it over, then send it to the kitchen.</p>
    </div>
</section>

<div class="wrap main">
    <form method="post" class="cart@(empty ? " is-empty" : "")" id="checkoutForm" data-cart
          data-stripe-key="@(Model.StripeEnabled && !Model.NeedsBooking ? Model.StripePublishableKey : "")">
        @* Pressing Enter in the promo box must apply the code, not trigger the first quantity button below. *@
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true" asp-page-handler="ApplyCode" formnovalidate>Apply promo code</button>

        <section aria-label="Your order">
            @if (errs.Count > 0)
            {
                <div class="form-alert" role="alert">
                    @Ui.Icon("warn", 18, 2)
                    <div>@foreach (var m in errs) { <p>@m</p> }</div>
                </div>
            }

            @if (empty)
            {
                <div class="empty-card">
                    <h2>Your cart is empty</h2>
                    <p>Add dishes, a set menu or a glass from the cellar and they will wait here.</p>
                    <a class="btn btn-wine" asp-page="/Menu/Index">See the menu</a>
                </div>
            }
            else
            {
                <div class="for">
                    @if (Model.Reservations.Count > 1)
                    {
                        <div>
                            <label for="resSelect"><b>For your reservation</b></label>
                            <select class="in" id="resSelect" name="Checkout.ReservationId" style="margin-top:8px">
                                @foreach (var r in Model.Reservations)
                                {
                                    <option value="@r.Id" selected="@(r.Id == Model.SelectedReservation?.Id)">@Booking(r)</option>
                                }
                            </select>
                        </div>
                    }
                    else if (Model.SelectedReservation != null)
                    {
                        <div>
                            <b>For your reservation</b>
                            <span class="muted">@Booking(Model.SelectedReservation)</span>
                            <input type="hidden" name="Checkout.ReservationId" value="@Model.SelectedReservation.Id" />
                        </div>
                        <a class="link" asp-page="/Reservations/Index">Change</a>
                    }
                    else
                    {
                        <div>
                            <b>No table booked yet</b>
                            <span class="muted">Book a table first and we will bring you straight back here to place your order for it.</span>
                        </div>
                        <a class="link" href="@Model.BookFirstUrl">Book a table</a>
                    }
                </div>

                @foreach (var ql in q.Lines)
                {
                    var c = ql.Cart;
                    <div class="line@(ql.Ok ? "" : " has-problem")">
                        @if (c.Kind == CartKind.SetMenu && string.IsNullOrWhiteSpace(c.ImageUrl))
                        {
                            @Ui.Placeholder("linen", "round")
                        }
                        else
                        {
                            @Ui.Pic(c.ImageUrl, c.Name, c.CategoryName, "round", alt: Pretty(c))
                        }
                        <div>
                            <h3>@Pretty(c)</h3>
                            <p>@Under(c)</p>
                            @if (!ql.Ok)
                            {
                                <p class="line-warn" role="alert">@Ui.Icon("warn", 15, 2) @ql.Problem</p>
                            }
                            <div class="qty" role="group" aria-label="Quantity of @Pretty(c)">
                                <button type="submit" asp-page-handler="SetQty" asp-route-key="@c.Key" asp-route-qty="@(c.Quantity - 1)" formnovalidate aria-label="One fewer @Pretty(c)">−</button>
                                <span aria-live="polite">@c.Quantity</span>
                                <button type="submit" asp-page-handler="SetQty" asp-route-key="@c.Key" asp-route-qty="@(c.Quantity + 1)" formnovalidate disabled="@(c.Quantity >= 50)" aria-label="One more @Pretty(c)">+</button>
                            </div>
                            <p class="rm"><button type="submit" class="link" asp-page-handler="Remove" asp-route-key="@c.Key" formnovalidate>Remove</button></p>
                        </div>
                        <div class="pr">@Ui.Rm(ql.Gross)</div>
                    </div>
                }

                <div class="form" style="margin-top:18px">
                    <div class="field">
                        <label for="kitchenNotes">Notes for the kitchen</label>
                        <textarea class="in" id="kitchenNotes" name="Checkout.Notes" rows="2" maxlength="400" placeholder="No coriander on the tartare, please.">@Model.Checkout.Notes</textarea>
                    </div>
                </div>
            }
        </section>

        @if (!empty)
        {
            <aside class="pay" aria-label="Payment">
                <div class="printed">
                    <h3>Payment</h3>

                    <div class="promo">
                        <input class="in@(q.CodeEntered != null && !q.CodeApplied ? " err" : "")" type="text" name="Checkout.PromoCode" value="@Model.Checkout.PromoCode" maxlength="30"
                               aria-label="Promo code" placeholder="Promo code" autocomplete="off" autocapitalize="characters" spellcheck="false" />
                        <button type="submit" class="btn btn-line btn-sm" asp-page-handler="ApplyCode" formnovalidate>Apply</button>
                    </div>
                    @if (q.CodeApplied)
                    {
                        <p class="applied">@Ui.Icon("check", 16, 2.4) @q.CodeMessage</p>
                    }
                    else if (!string.IsNullOrEmpty(q.CodeMessage))
                    {
                        <p class="applied bad" role="status">@Ui.Icon("warn", 16, 2) @q.CodeMessage</p>
                    }

                    <div class="tot">
                        <span>Subtotal</span><span>@Ui.Rm2(q.SubTotal)</span>
                        @if (q.ServiceCharge > 0)
                        {
                            <span>Service charge (@q.ServiceChargePercent.ToString("0.##")%)</span><span>@Ui.Rm2(q.ServiceCharge)</span>
                        }
                        @if (q.Discount > 0)
                        {
                            <span class="disc">@(q.CodeApplied ? "Promo " + q.CodeEntered!.ToUpperInvariant() : "Offers")</span><span class="disc">− @Ui.Rm2(q.Discount)</span>
                        }
                        @if (q.Tax > 0)
                        {
                            <span>Tax (@q.TaxPercent.ToString("0.##")%)</span><span>@Ui.Rm2(q.Tax)</span>
                        }
                        <span class="sum">Total</span><span class="sum" id="cartTotal">@Ui.Rm2(q.Total)</span>
                    </div>

                    <div class="earn">
                        @Ui.Icon("crown", 22, 1.6)
                        <span>You will earn <b>@q.PointsEstimate.ToString("N0") points</b> with this order.</span>
                    </div>

                    <fieldset class="method" aria-label="Pay with">
                        <legend class="sr-only">Pay with</legend>
                        <label class="opt@(online ? "" : " off")">
                            <input type="radio" name="Checkout.PaymentMethod" value="OnlinePayment" checked="@(method == PaymentMethod.OnlinePayment)" disabled="@(!online)" />
                            <span><span class="ck"><i class="rad"></i>Card, paid securely online</span></span>
                            @Ui.Icon("card", 22, 1.6)
                        </label>
                        <label class="opt@(online ? "" : " off")">
                            <input type="radio" name="Checkout.PaymentMethod" value="OnlineBanking" checked="@(method == PaymentMethod.OnlineBanking)" disabled="@(!online)" />
                            <span><span class="ck"><i class="rad"></i>Online banking</span></span>
                            @Ui.Icon("globe", 22, 1.6)
                        </label>
                        <label class="opt">
                            <input type="radio" name="Checkout.PaymentMethod" value="Cash" checked="@(method == PaymentMethod.Cash)" />
                            <span><span class="ck"><i class="rad"></i>Pay at the restaurant</span></span>
                            @Ui.Icon("receipt", 22, 1.6)
                        </label>
                    </fieldset>
                    @if (!online)
                    {
                        <p class="hint-line">Paying online is not switched on yet. Please pay at the restaurant.</p>
                    }
                    <p class="hint-line" data-banking-note hidden="@(method != PaymentMethod.OnlineBanking)">You will go to your bank's page to approve the payment, then come straight back here.</p>

                    <div id="payment-element" class="pay-el" hidden></div>
                    <p id="paymentElementErrors" class="err-msg" role="alert"></p>
                    <input type="hidden" name="Checkout.StripePaymentIntentId" id="stripePaymentIntentIdInput" />

                    @if (Model.NeedsBooking)
                    {
                        <a class="btn btn-wine btn-lg" href="@Model.BookFirstUrl" style="width:100%;margin-top:22px">Book a table to order</a>
                        <p class="hint-line">Orders are brought to your table, so we need a booking first. You pay once it is made.</p>
                    }
                    else
                    {
                        <button type="submit" id="placeOrderBtn" class="btn btn-wine btn-lg" asp-page-handler="Checkout" disabled="@blocked" style="width:100%;margin-top:22px">Place order</button>
                    }
                    @if (q.HasProblem)
                    {
                        <p class="fine-line">Take out the item marked above to place your order.</p>
                    }
                    <p class="stripe">Card payments are handled by Stripe. We never see your card number.</p>
                </div>
            </aside>
        }
    </form>
</div>

@section Scripts {
    @if (Model.StripeEnabled)
    {
        <script src="https://js.stripe.com/v3/"></script>
    }
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
