@page
@model RROMS.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "My Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">My Reservations</h1>
    <a asp-page="/Reservations/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New reservation</a>
</div>

<h2 class="h5 mb-3">Upcoming</h2>
@if (!Model.Upcoming.Any())
{
    <div class="rroms-card p-4 text-center text-muted-warm mb-4">No upcoming reservations yet.</div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var r in Model.Upcoming)
        {
            <div class="col-md-6">
                <div class="rroms-card p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold">@r.ReservationDateTime.ToString("dddd, dd MMM yyyy")</div>
                            <div class="text-muted-warm small">@r.ReservationDateTime.ToString("h:mm tt") &middot; Party of @r.PartySize</div>
                            <div class="text-muted-warm small">Table @(r.Table?.TableNumber ?? "TBD") &middot; @(r.Table?.DiningArea?.Name)</div>
                        </div>
                        <span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.SpecialRequests))
                    {
                        <p class="small text-muted-warm mt-2 mb-2"><i class="bi bi-chat-left-text"></i> @r.SpecialRequests</p>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <a asp-page="/Reservations/Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Modify</a>
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" onsubmit="return confirm('Cancel this reservation?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                        <a asp-page="/Orders/Cart" asp-route-reservationId="@r.Id" class="btn btn-sm btn-herb ms-auto">Order for this visit</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="h5 mb-3">Past &amp; cancelled</h2>
@if (!Model.Past.Any())
{
    <div class="rroms-card p-4 text-center text-muted-warm">No past reservations yet.</div>
}
else
{
    <div class="table-responsive rroms-card p-2">
        <table class="table rroms-table mb-0">
            <thead><tr><th>Date</th><th>Time</th><th>Party</th><th>Table</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Past)
                {
                    <tr>
                        <td>@r.ReservationDateTime.ToString("dd MMM yyyy")</td>
                        <td>@r.ReservationDateTime.ToString("h:mm tt")</td>
                        <td>@r.PartySize</td>
                        <td>@(r.Table?.TableNumber ?? "-")</td>
                        <td><span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
