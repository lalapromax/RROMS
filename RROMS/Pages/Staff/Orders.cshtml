@page
@model RROMS.Pages.Staff.OrdersModel
@using RROMS.Models
@using RROMS.Presentation
@{
    ViewData["Title"] = "Orders";
    var cols = new (OrderStatus S, string Title, string? Next, string? Label)[]
    {
        (OrderStatus.Placed, "Placed", "Preparing", "Start preparing"),
        (OrderStatus.Preparing, "Preparing", "ReadyToServe", "Mark ready"),
        (OrderStatus.ReadyToServe, "Ready", "Served", "Mark served"),
        (OrderStatus.Served, "Served", null, null)
    };
    string Age(Order o)
    {
        var m = (int)Math.Max(0, (DateTime.UtcNow - o.OrderDate).TotalMinutes);
        return m < 60 ? m + " min" : (m / 60) + " h " + (m % 60).ToString("00");
    }
    string Place(Order o) => o.Table != null ? "Table " + o.Table.TableNumber.TrimStart('T', 't') : "Takeaway";
    var keep = new Dictionary<string, string?>();
    if (Model.TableId.HasValue) keep["tableId"] = Model.TableId.ToString();
}

<div class="wrap main stage">
    <div class="page-head">
        <div>
            <h1>Orders</h1>
            <p>Move each order along. Guests see the status change on their phone.</p>
        </div>
        <div class="row-acts">
            <a class="btn btn-wine" asp-page="/Staff/NewOrder">Add an order</a>
        </div>
    </div>

    <form method="get" class="filter" data-autosubmit role="search" aria-label="Filter the board">
        <div class="field">
            <label for="ft">Table</label>
            <select class="in" id="ft" name="tableId" style="width:170px">
                <option value="">All tables</option>
                @foreach (var t in Model.Tables)
                {
                    <option value="@t.Id" selected="@(Model.TableId == t.Id)">@t.Number</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-line btn-sm2" data-no-js-only style="min-height:44px">Show</button>
        <span class="sp"></span>
        <span class="muted">The board refreshes itself every 20 seconds.</span>
    </form>

    <div class="board" id="board" data-refresh="20">
        @foreach (var c in cols)
        {
            var list = Model.In(c.S).ToList();
            <section aria-label="@c.Title">
                <div class="sp-b" style="margin-bottom:12px">
                    <h2 style="font-size:28px;font-weight:500">@c.Title</h2>
                    <span class="sample">@list.Count</span>
                </div>
                <div class="stack">
                    @if (list.Count == 0)
                    {
                        <p class="board-none">@(c.S == OrderStatus.Placed ? "Nothing waiting." : "Nothing here.")</p>
                    }
                    @foreach (var o in list)
                    {
                        var lines = OrderView.Lines(o);
                        var allergy = DietaryRules.SplitAllergies(o.Customer?.Allergies);
                        var allergyText = string.Join(", ", allergy.Chips.Select(DietaryRules.AllergenLabel).Concat(string.IsNullOrWhiteSpace(allergy.Other) ? Array.Empty<string>() : new[] { allergy.Other.Trim() }));
                        <article class="panel o-card" style="padding:18px 20px;box-shadow:var(--e1)">
                            <div class="sp-b">
                                <h3 style="font-size:26px;font-weight:500">@Place(o)</h3>
                                <span class="muted" style="font-size:13.5px">@Age(o)</span>
                            </div>
                            @if (o.Table == null)
                            {
                                <p class="muted" style="font-size:13.5px">@(o.Customer?.IsSystemAccount == true ? "At the counter" : o.Customer?.FullName)</p>
                            }
                            <ul style="margin-top:8px">
                                @foreach (var l in lines)
                                {
                                    <li class="o-line">
                                        <span>@l.Title@if (l.IsSet && !string.IsNullOrEmpty(l.Sub)) { <small>@l.Sub</small> }</span>
                                        <b>@l.Quantity</b>
                                    </li>
                                }
                            </ul>
                            @if (allergyText.Length > 0)
                            {
                                <p class="note-box warn" style="margin-top:10px;padding:10px 12px;font-size:13.5px">@Ui.Icon("warn", 13, 2.2) Allergy: @allergyText</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(o.Notes))
                            {
                                <p class="note-box" style="margin-top:10px;padding:10px 12px;font-size:13.5px">@o.Notes</p>
                            }
                            <div style="margin-top:14px">
                                @if (c.Next != null)
                                {
                                    <form method="post" asp-page-handler="Advance" asp-all-route-data="keep">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="to" value="@c.Next" />
                                        <button class="btn btn-wine btn-sm2" style="width:100%">@c.Label</button>
                                    </form>
                                }
                                else if (o.Payment?.Status == PaymentStatus.Paid)
                                {
                                    <form method="post" asp-page-handler="Advance" asp-all-route-data="keep">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="to" value="Completed" />
                                        <button class="btn btn-line btn-sm2" style="width:100%">Paid. Close the order</button>
                                    </form>
                                }
                                else
                                {
                                    <a class="btn btn-line btn-sm2" style="width:100%" asp-page="/Staff/Billing" asp-route-searchOrderId="@o.Id">Send to billing</a>
                                }
                                <form method="post" asp-page-handler="Cancel" asp-all-route-data="keep" data-confirm="Cancel this order? The guest will be told@(o.Payment?.Status == PaymentStatus.Paid ? " and any online payment is returned" : "").">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <button class="linkbtn" type="submit">Cancel order</button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @if (Model.Ahead.Count > 0)
    {
        <section class="ahead" aria-labelledby="aheadT" style="margin-top:36px">
            <div class="sp-b" style="margin-bottom:12px">
                <h2 id="aheadT" style="font-size:28px;font-weight:500">Ordered ahead</h2>
                <span class="sample">@Model.Ahead.Count</span>
            </div>
            <p class="muted" style="margin-bottom:14px">Sent before the guests arrived. Each one moves to Placed when its table is seated.</p>
            <div class="grid2 g3">
                @foreach (var o in Model.Ahead)
                {
                    <article class="panel o-card" style="padding:18px 20px">
                        <div class="sp-b">
                            <h3 style="font-size:24px;font-weight:500">@Place(o)</h3>
                            <span class="muted" style="font-size:13.5px">@o.Reservation!.ReservationDateTime.ToString("ddd d MMM, HH:mm")</span>
                        </div>
                        <p class="muted" style="font-size:13.5px">@o.Customer?.FullName</p>
                        <ul style="margin-top:8px">
                            @foreach (var l in OrderView.Lines(o))
                            {
                                <li class="o-line"><span>@l.Title</span><b>@l.Quantity</b></li>
                            }
                        </ul>
                    </article>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/staff-board.js" asp-append-version="true"></script>
}
