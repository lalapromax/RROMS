@inject IChromeService Chrome
@{
    // Staff shell: the olive bar with only the front-of-house tools. No guest ordering, no admin pages.
    var c = await Chrome.GetAsync();
    var path = Context.Request.Path;
    string Cur(params string[] prefixes) => prefixes.Any(x => path.StartsWithSegments(x)) ? "page" : null!;
    var homeHref = Url.Page("/Staff/Dashboard")!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="~/css/blm-app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app staff-area">
    <a class="skip" href="#main">Skip to the page</a>
    <partial name="_Sprite" />

    <header class="app-bar staff">
        <button type="button" class="burger" aria-label="Open menu" aria-controls="navSheet" data-dialog-open="navSheet">@Ui.Icon("burger", 20, 1.7)</button>
        <partial name="_Seal" model="@(new SealVM(homeHref, "staff home", c.HasLogo))" />
        <nav class="nav-main" aria-label="Staff">
            <a asp-page="/Staff/Dashboard" aria-current="@Cur("/Staff/Dashboard")">Dashboard</a>
            <a asp-page="/Staff/Reservations" aria-current="@Cur("/Staff/Reservations")">Reservations@if (c.PendingReservations > 0) { <span class="badge" title="@c.PendingReservations waiting">@(c.PendingReservations > 9 ? "9+" : c.PendingReservations.ToString())</span> }</a>
            <a asp-page="/Staff/Orders" aria-current="@Cur("/Staff/Orders")">Orders</a>
            <a asp-page="/Staff/Billing" aria-current="@Cur("/Staff/Billing")">Billing</a>
            <a asp-page="/Staff/SetMenus" aria-current="@Cur("/Staff/SetMenus")">Set menus</a>
            <a asp-page="/Staff/Announcements" aria-current="@Cur("/Staff/Announcements")">Announcements</a>
        </nav>
        <span class="role-pill">Staff</span>
        <partial name="_AccountMenu" />
    </header>

    <dialog class="sheet dark" id="navSheet" aria-label="Menu">
        <div class="sheet-head">
            <partial name="_Seal" model="@(new SealVM(homeHref, "staff home", c.HasLogo))" />
            <button type="button" class="x-btn" aria-label="Close menu" data-dialog-close style="color:var(--batter);border-color:rgba(232,209,167,.4)">@Ui.Icon("x", 16, 2)</button>
        </div>
        <nav aria-label="Staff menu">
            <a asp-page="/Staff/Dashboard" aria-current="@Cur("/Staff/Dashboard")">Dashboard</a>
            <a asp-page="/Staff/Reservations" aria-current="@Cur("/Staff/Reservations")">Reservations@if (c.PendingReservations > 0) { <span class="badge-n">@c.PendingReservations</span> }</a>
            <a asp-page="/Staff/Orders" aria-current="@Cur("/Staff/Orders")">Orders</a>
            <a asp-page="/Staff/Billing" aria-current="@Cur("/Staff/Billing")">Billing</a>
            <a asp-page="/Staff/SetMenus" aria-current="@Cur("/Staff/SetMenus")">Set menus</a>
            <a asp-page="/Staff/Announcements" aria-current="@Cur("/Staff/Announcements")">Announcements</a>
            <hr />
            <a asp-page="/Account/Profile">Your profile</a>
            <a asp-page="/Notifications/Index">Notifications@if (c.Unread > 0) { <span class="badge-n">@c.Unread</span> }</a>
            <form method="post" asp-page="/Account/Logout"><button type="submit">Sign out</button></form>
        </nav>
    </dialog>

    <main id="main" tabindex="-1">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <script src="~/js/blm.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
