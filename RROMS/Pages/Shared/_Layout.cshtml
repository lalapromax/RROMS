@inject IChromeService Chrome
@{
    // Guest shell: the paper bar (Menu / Set menus / The cellar, the seal, Rewards, cart, bell, Reserve a table, account) on desktop,
    // the burger bar on phones. Staff and administrators get their own shells (see _ViewStart.cshtml).
    var c = await Chrome.GetAsync();
    var signedIn = c.SignedIn;
    var path = Context.Request.Path;
    var onMenu = path.StartsWithSegments("/Menu");
    var showUnreadNotifications = c.Unread > 0;
    string Cur(params string[] prefixes) => prefixes.Any(x => path.StartsWithSegments(x)) ? "page" : null!;
    var bundle = ViewData["Bundle"] as string ?? "full";   // full = guest pages, guest = Rewards, lite = Home and Menu
    var homeHref = Url.Page("/Index")!;
    var rewardsHref = signedIn ? Url.Page("/Rewards/Index")! : Url.Page("/Index")! + "#rewards";
    var cartLabel = c.CartCount > 0 ? $"Your cart, {c.CartCount} {(c.CartCount == 1 ? "item" : "items")}" : "Your cart";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    @if (bundle != "lite")
    {
        <link rel="stylesheet" href="~/css/blm-guest.css" asp-append-version="true" />
        @if (bundle == "full")
        {
            <link rel="stylesheet" href="~/css/blm-guest-x.css" asp-append-version="true" />
        }
        <link rel="stylesheet" href="~/css/blm-guest-real.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="guest">
    <a class="skip" href="#main">Skip to the page</a>
    <partial name="_Sprite" />

    <header class="nav">
        <nav class="nav-links" aria-label="Primary">
            <a asp-page="/Menu/Index" asp-fragment="carte" aria-current="@(onMenu ? "page" : null)">Menu</a>
            <a asp-page="/Menu/Index" asp-fragment="sets">Set menus</a>
            <a asp-page="/Menu/Index" asp-fragment="cellar">The cellar</a>
        </nav>
        <partial name="_Seal" model="@(new SealVM(homeHref, "home", c.HasLogo))" />
        <div class="nav-links nav-right">
            <a href="@rewardsHref" aria-current="@Cur("/Rewards")">Rewards</a>
            @if (signedIn)
            {
                <a class="icon-btn ib-cart" asp-page="/Orders/Cart" aria-label="@cartLabel">@Ui.Icon("cart")@if (c.CartCount > 0) {
                    <i class="ib-count">@(c.CartCount > 9 ? "9+" : c.CartCount.ToString())</i>
                }
            </a>
            <a class="icon-btn ib-bell" asp-page="/Notifications/Index" aria-label="@(c.Unread > 0 ? $"Notifications, {c.Unread} new" : "Notifications")">@Ui.Icon("bell")@if (c.Unread > 0) {
                <i class="ib-dot"></i>
            }
        </a>
    }
    <a class="btn btn-wine btn-sm" asp-page="/Reservations/Create">Reserve a table</a>
    @if (signedIn)
    {
        <partial name="_AccountMenu" />
    }
    else
    {
        <a class="btn btn-line btn-sm" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Sign in</a>
    }
</div>
</header>

<header class="bar">
    <button type="button" class="burger" aria-label="Open menu" aria-controls="navSheet" data-dialog-open="navSheet">@Ui.Icon("burger", 20, 1.7)</button>
    <partial name="_Seal" model="@(new SealVM(homeHref, "home", c.HasLogo))" />
    @if (signedIn)
    {
        <a class="burger ib-cart" asp-page="/Orders/Cart" aria-label="@cartLabel">@Ui.Icon("bag")@if (c.CartCount > 0) {
            <i class="ib-count">@(c.CartCount > 9 ? "9+" : c.CartCount.ToString())</i>
        }
    </a>
}
        else
{
    <a class="btn btn-wine" asp-page="/Reservations/Create">Reserve</a>
}
</header>

<dialog class="sheet" id="navSheet" aria-label="Menu">
    <div class="sheet-head">
        <partial name="_Seal" model="@(new SealVM(homeHref, "home", c.HasLogo))" />
        <button type="button" class="x-btn" aria-label="Close menu" data-dialog-close>@Ui.Icon("x", 16, 2)</button>
    </div>
    <nav aria-label="Menu">
        <a asp-page="/Menu/Index" asp-fragment="carte" data-dialog-close>Menu</a>
        <a asp-page="/Menu/Index" asp-fragment="sets" data-dialog-close>Set menus</a>
        <a asp-page="/Menu/Index" asp-fragment="cellar" data-dialog-close>The cellar</a>
        <a href="@rewardsHref">Rewards</a>
        <a asp-page="/Announcements/Index" aria-current="@Cur("/Announcements")">News and notices</a>
        <hr />
        @if (signedIn)
        {
            <span class="sheet-label">@(string.IsNullOrWhiteSpace(c.DisplayName) ? "Your account" : c.DisplayName)</span>
            <a asp-page="/Reservations/Create">Reserve a table</a>
            <a asp-page="/Reservations/Index">My reservations</a>
            <a asp-page="/Orders/Index">My orders</a>
            <a asp-page="/Feedback/Index">My reviews</a>
            <a asp-page="/Notifications/Index">Notifications@(showUnreadNotifications ? Html.Raw($" <span class=\"badge-n\">{c.Unread}</span>") : Html.Raw(""))</a>
            <a asp-page="/Account/Profile">Profile and dietary details</a>
            <form method="post" asp-page="/Account/Logout"><button type="submit">Sign out</button></form>
        }
        else
        {
            <a asp-page="/Reservations/Create">Reserve a table</a>
            <a asp-page="/Account/Login">Sign in</a>
            <a asp-page="/Account/Register">Create an account</a>
        }
    </nav>
</dialog>

<main id="main" tabindex="-1">
    @RenderBody()
</main>

<partial name="_Flash" />

<footer class="foot">
    <svg class="grain" aria-hidden="true" focusable="false"><rect filter="url(#gn)"></rect></svg>
    <div class="wrap foot-in">
        <div>
            <partial name="_Seal" model="@(new SealVM(homeHref, "home", c.HasLogo))" />
            <p class="foot-copy">Allergies, a birthday, a table by the window? Tell us when you book and we will take it from there.</p>
        </div>
        <div>
            <h4>Visit</h4>
            <ul>
                @if (!string.IsNullOrWhiteSpace(c.Setting?.Address))
                {
                    <li>@c.Setting!.Address</li>
                }
                @foreach (var line in c.HoursLines)
                {
                    <li>@line</li>
                }
                @if (c.Setting?.PublicPhone is string phone)
                {
                    <li><a href="tel:@(new string(phone.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()))">@phone</a></li>
                }
                @if (!string.IsNullOrWhiteSpace(c.Setting?.Email))
                {
                    <li><a href="mailto:@c.Setting!.Email">@c.Setting!.Email</a></li>
                }
            </ul>
        </div>
        <div>
            <h4>Explore</h4>
            <ul>
                <li><a asp-page="/Menu/Index" asp-fragment="carte">Menu</a></li>
                <li><a asp-page="/Menu/Index" asp-fragment="sets">Set menus</a></li>
                <li><a asp-page="/Menu/Index" asp-fragment="cellar">The cellar</a></li>
                <li><a href="@rewardsHref">Rewards</a></li>
                <li><a asp-page="/Announcements/Index">News and notices</a></li>
            </ul>
        </div>
    </div>
    <div class="wrap foot-note">© @DateTime.Now.Year @Brand.Name. All rights reserved.</div>
</footer>

@* the checkout stays free of anything that could cover its buttons *@
@if (!path.StartsWithSegments("/Orders/Cart"))
{
    <partial name="_ChatWidget" />
}

<script src="~/js/blm.js" asp-append-version="true"></script>
<script src="~/js/chatbot.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
