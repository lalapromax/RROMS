@page
@model RROMS.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/Login.css" asp-append-version="true" />
}

<div class="auth">
    <aside class="auth-art">
        <svg class="grain" aria-hidden="true" focusable="false"><rect filter="url(#gn)"></rect></svg>
        @Ui.Plate("d-house", "wine", "arch", "arch")
        <h2>It happens to everyone.</h2>
        <p>We will send a link to the email on your account.</p>
    </aside>
    <section class="auth-form">
        <div class="auth-card">
            <h1>Reset your password</h1>
            @if (Model.Sent)
            {
                <p class="lead-it">Check your email.</p>
                <div class="banner" role="status" style="border-color:var(--olive-deep);background:var(--linen)">
                    @Ui.Icon("mail", 20, 1.6)
                    <div>
                        If there is an account for that address, a link to choose a new password is on its way.
                        @if (!Model.EmailConfigured)
                        {
                            <span style="display:block;margin-top:6px"><b>This site cannot send email yet.</b> Please ask the restaurant to reset your password for you.</span>
                        }
                    </div>
                </div>
                <p class="alt"><a class="link" asp-page="/Account/Login">Back to sign in</a></p>
            }
            else
            {
                <p class="lead-it">Enter your email and we will send you a link.</p>
                <form method="post" class="form" novalidate>
                    <div class="field">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="in@(Ui.Err(ViewData.ModelState, "Input.Email"))" type="email" autocomplete="email" autofocus />
                        <span asp-validation-for="Input.Email" class="err-msg"></span>
                    </div>
                    <button type="submit" class="btn btn-wine btn-lg" style="width:100%;margin-top:8px">Send the link</button>
                </form>
                <p class="alt">Remembered it? <a class="link" asp-page="/Account/Login">Sign in</a></p>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
