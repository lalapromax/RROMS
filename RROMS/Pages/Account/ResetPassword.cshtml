@page
@model RROMS.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    var formErrors = ViewData.ModelState.TryGetValue(string.Empty, out var e) ? e.Errors.Select(x => x.ErrorMessage).ToList() : new List<string>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/Register.css" asp-append-version="true" />
}

<div class="auth">
    <aside class="auth-art">
        <svg class="grain" aria-hidden="true" focusable="false"><rect filter="url(#gn)"></rect></svg>
        @Ui.Plate("d-house", "wine", "arch", "arch")
        <h2>A fresh start.</h2>
        <p>Choose a password you have not used elsewhere.</p>
    </aside>
    <section class="auth-form">
        <div class="auth-card">
            <h1>Choose a new password</h1>
            @if (formErrors.Count > 0)
            {
                <div class="banner" role="alert">
                    @Ui.Icon("warn", 20, 1.6)
                    <div>@string.Join(" ", formErrors) <a class="link" asp-page="/Account/ForgotPassword">Ask for a new link</a></div>
                </div>
            }
            <form method="post" class="form" novalidate>
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Code" />
                <div class="field">
                    <label asp-for="Input.Password">New password</label>
                    <div class="pw">
                        <input asp-for="Input.Password" class="in@(Ui.Err(ViewData.ModelState, "Input.Password"))" autocomplete="new-password" data-password-check autofocus />
                        <button type="button" class="show" data-toggle-password="Input_Password" aria-pressed="false">Show</button>
                    </div>
                    <div class="meter-pw" aria-hidden="true" data-pw-meter><i></i><i></i><i></i><i></i></div>
                    <div class="rules" data-pw-rules>
                        <span data-rule="len"><i>@Ui.Icon("check", 11, 3.2)</i> At least 8 characters</span>
                        <span data-rule="upper"><i>@Ui.Icon("check", 11, 3.2)</i> An upper-case letter</span>
                        <span data-rule="digit"><i>@Ui.Icon("check", 11, 3.2)</i> A number</span>
                        <span data-rule="symbol"><i>@Ui.Icon("check", 11, 3.2)</i> A symbol, such as ! or #</span>
                    </div>
                    <span asp-validation-for="Input.Password" class="err-msg"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" class="in@(Ui.Err(ViewData.ModelState, "Input.ConfirmPassword"))" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="err-msg"></span>
                </div>
                <button type="submit" class="btn btn-wine btn-lg" style="width:100%;margin-top:8px">Save new password</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-ui.js" asp-append-version="true"></script>
}
