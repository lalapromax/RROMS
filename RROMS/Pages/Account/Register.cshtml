@page
@model RROMS.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create your account";
}
<div class="rroms-card auth-card p-4 p-md-5">
    <h1 class="h3 mb-1">Create your account</h1>
    <p class="text-muted-warm mb-4">Book tables, order ahead, and track your visits.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.FullName" class="form-label"></label>
            <input asp-for="Input.FullName" class="form-control" autofocus />
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Phone" class="form-label"></label>
            <input asp-for="Input.Phone" class="form-control" />
        </div>
        <div class="row">
            <div class="mb-3 col-md-6">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="mb-3 col-md-6">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Input.DietaryPreference" class="form-label"></label>
            <input asp-for="Input.DietaryPreference" class="form-control" placeholder="e.g. Vegetarian, nut allergy" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Create account</button>
    </form>

    <p class="text-center mt-4 mb-0 small">Already have an account? <a asp-page="/Account/Login">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
