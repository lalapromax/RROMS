@page
@model RROMS.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Your profile";
    var app = (ViewData["Audience"] as string ?? "guest") != "guest";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/Profile.css" asp-append-version="true" />
}

@if (app)
{
    <div class="wrap main stage">
        <div class="page-head">
            <div>
                <h1>Your profile</h1>
                <p>Details we use for your account and sign-in.</p>
            </div>
        </div>
        <partial name="_ProfileBody" model="Model" />
    </div>
}
else
{
    <section class="wrap page-top">
        <div>
            <h1>Your profile</h1>
            <p class="lead-it">Details we use for your bookings and orders.</p>
        </div>
    </section>
    <div class="wrap main">
        <partial name="_ProfileBody" model="Model" />
    </div>
}

@section Scripts {
    <script src="~/js/password-ui.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
