@page
@model RROMS.Pages.Account.LoginModel
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Sign in";
    var googleVm = new GoogleSignInVM(Model.GoogleClientId, Url.Page("/Account/Login", "Google")!, Model.ReturnUrl, "signin_with");
    var formErrors = ViewData.ModelState.TryGetValue(string.Empty, out var e) ? e.Errors.Select(x => x.ErrorMessage).ToList() : new List<string>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/Login.css" asp-append-version="true" />
}

<div class="auth">
    <aside class="auth-art">
        @Ui.Placeholder("wine", "arch", "arch")
        <h2>Your table is waiting.</h2>
        <p>Sign in to book, order ahead and collect your points.</p>
    </aside>
    <section class="auth-form">
        <div class="auth-card">
            <h1>Sign in</h1>
            <p class="lead-it">Good to see you again.</p>
            @if (formErrors.Count > 0)
            {
                <div class="banner" role="alert">
                    @Ui.Icon("warn", 20, 1.6)
                    <div>
                        <b>We could not sign you in.</b><br />
                        @string.Join(" ", formErrors)
                    </div>
                </div>
            }
            <form method="post" class="form" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="in@(Ui.Err(ViewData.ModelState, "Input.Email"))" type="email" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Email" class="err-msg"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Password">Password</label>
                    <div class="pw">
                        <input asp-for="Input.Password" class="in@(Ui.Err(ViewData.ModelState, "Input.Password"))" autocomplete="current-password" />
                        <button type="button" class="show" data-toggle-password="Input_Password" aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="err-msg"></span>
                </div>
                <div class="row-sp">
                    <label class="ckb"><input asp-for="Input.RememberMe" type="checkbox" /><i>@Ui.Icon("check", 13, 3)</i> Keep me signed in on this device</label>
                    <a class="link" asp-page="/Account/ForgotPassword">Forgot your password?</a>
                </div>
                <button type="submit" class="btn btn-wine btn-lg" style="width:100%">Sign in</button>
            </form>
            <div class="or">or</div>
            <partial name="_GoogleSignIn" model="googleVm" />
            <p class="alt">New to La Mélancolie? <a class="link" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
            @if (Env.IsDevelopment())
            {
                <details class="demo-accounts">
                    Demo accounts (development only)
                    <ul>
                        <li>Administrator: admin@rroms.local / Admin@12345</li>
                        <li>Staff: staff@rroms.local / Staff@12345</li>
                        <li>Customer: customer@rroms.local / Customer@12345</li>
                    </ul>
                </details>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
